// Cloudflare Pages project for the powerhouse site (classic Pages). Static
// files only: the site is public/, served as is, with no build step.
// (Created with `wrangler pages project create --force`; Wrangler now hands
// new Pages projects to Workers by default. Existing ones deploy normally.)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usepowerhouse",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-06-11"
}
