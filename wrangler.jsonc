// The powerhouse site: static files in public/, served by a Worker with no
// code of its own (Workers static assets, which Cloudflare now calls Pages).
// public/_headers sets the security headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usepowerhouse",
  "compatibility_date": "2026-06-11",
  "assets": { "directory": "./public" }
}
